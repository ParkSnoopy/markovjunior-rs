<sequence values="DAWU">
  <prl in="***/*D*/***" out="***/*A*/***"/>
  <prl in="A" out="D" p="0.45" steps="1"/>
  <convolution neighborhood="Moore">
    <rule in="A" out="D" sum="5..8" values="D"/>
    <rule in="D" out="A" sum="6..8" values="A"/>
  </convolution>
  <all in="AD/DA" out="AA/DA"/>
  <!-- Flood one chamber and tunnel through solid rock until every cave pocket connects. -->
  <markov>
    <all in="WA" out="WW"/>
    <path from="W" to="A" on="D" color="A" inertia="true"/>
    <one in="A" out="W"/>
  </markov>
  <all in="WD/DW" out="WW/DW"/>
  <!-- Fill deep interior basins with subterranean water and outline rock walls. -->
  <convolution neighborhood="Moore" steps="2">
    <rule in="W" out="U" sum="8..8" values="WU"/>
  </convolution>
  <all>
    <rule in="DW" out="AW"/>
    <rule in="D*/*W" out="A*/*W"/>
  </all>
</sequence>
