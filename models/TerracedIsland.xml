<sequence values=".RWGBL" origin="true" symmetry="(xy)">
  <union symbol="~" values="RW"/>
  <one in="R ." out=". R"/>
  <prl in="~." out="*W"/>
  <!-- A connected shore grows out of one rock in the water plane. -->
  <one in="RW" out="*R" steps="45"/>
  <prl in="RW" out="*R" p="0.35" steps="14"/>
  <!-- Deposit only over a supported patch. Narrow peninsulas cannot rise as high as broad interiors. -->
  <prl in="***/**./*** **R/*RR/**R" out="***/**R/*** ***/***/***" p="0.55" steps="10"/>
  <prl in=". R" out="* G"/>
  <prl in="WG" out="*B"/>
  <prl in=". G" out="L *" p="0.08" steps="1"/>
</sequence>