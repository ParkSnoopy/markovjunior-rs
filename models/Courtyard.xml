<sequence values=".RSG" origin="true" symmetry="(xy)">
  <!-- Lower the first room site until exactly one layer fits beneath it. -->
  <one in="R . ." out=". R *"/>
  <!-- Place one bay. G is a connection point in a wall; R is an open roof site. -->
  <one in=".../.../... .../.R./... .../.../..." out="SSS/SRS/SSS SGS/G.G/SGS SSS/SSS/SSS"/>
  <!-- Grow wings: one wall and a vacant volume permit a whole new room or long hall.
       Open a doorway through the shared wall as the new bay attaches. -->
  <one steps="12">
    <rule in="*.../*.../*... *.../G.../*... *.../*.../*..." out="*SSS/*SRS/*SSS *SGS/...G/*SGS *SSS/*SSS/*SSS"/>
    <rule in="*....../*....../*...... *....../G....../*...... *....../*....../*......" out="*SSSSSS/*SRSSRS/*SSSSSS *SGSSGS/......G/*SGSSGS *SSSSSS/*SSSSSS/*SSSSSS"/>
  </one>
  <!-- Each exposed roof can support another storey, or close as a terrace.
       The same rule can act on its own new roof. No height map is supplied. -->
  <one>
    <rule in=".../.../... .../.../... .../.../... ***/*R*/***" out="SSS/SRS/SSS SGS/G.G/SGS SSS/SSS/SSS ***/*S*/***"/>
    <rule in="R" out="S"/>
  </one>
</sequence>